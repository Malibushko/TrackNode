{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "f411-debug",
      "displayName": "STM32F411 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f411-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STM32CUBE_F4_ROOT": "$env{STM32CUBE_F4_ROOT}",
        "TRACK_NODE_ENABLE_BLUETOOTH": "ON",
        "TRACK_NODE_ENABLE_LORA": "OFF",
        "TRACK_NODE_ENABLE_GNSS": "OFF",
        "NO_STORAGE": "ON",
        "FAULT_INJECTION_ENABLE": "OFF",
        "PERF_MEASURING": "OFF",
        "TRACK_NODE_DEBUG_IN_SLEEP": "OFF",
        "TRACK_NODE_POWER_STATS": "ON"
      }
    },
    {
      "name": "f411-release",
      "displayName": "STM32F411 Release",
      "inherits": "f411-debug",
      "binaryDir": "${sourceDir}/build/f411-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "f411-debug",
      "configurePreset": "f411-debug"
    },
    {
      "name": "f411-release",
      "configurePreset": "f411-release"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
