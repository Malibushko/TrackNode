{
  "version": 6,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "f411",
      "displayName": "STM32F411 firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/f411",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STM32CUBE_F4_ROOT": "$env{STM32CUBE_F4_ROOT}"
      }
    },
    {
      "name": "f411-fault",
      "displayName": "STM32F411 fault injection",
      "inherits": "f411",
      "binaryDir": "${sourceDir}/build/f411-fault",
      "cacheVariables": {
        "FAULT_INJECTION_ENABLE": "ON",
        "PERF_MEASURING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "f411", "configurePreset": "f411" },
    { "name": "f411-fault", "configurePreset": "f411-fault" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } }
  ]
}
