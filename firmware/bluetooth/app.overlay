/ {
	aliases {
		bridge-uart = &uart0;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

/ {
	zephyr,user {
		bridge-rx-gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};

&uart0_sleep {
	/delete-node/ group1;

	group1 {
		psels = <NRF_PSEL(UART_TX, 1, 11)>;
	};

	group2 {
		psels = <NRF_PSEL(UART_RX, 1, 12)>;
		bias-pull-up;
	};
};
